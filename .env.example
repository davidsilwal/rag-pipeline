#!/usr/bin/env python3
"""env.example — Environment variable templates for the LLM Markdown Wiki Pipeline.

Generated on: 2026-08-20
Contains all required and optional environment variables for the full pipeline.
"""


# ============================================================================
# VPS Control Plane
# ============================================================================

# Database
DATABASE_URL="postgresql://gpu_worker:__GENERATE__@VPS_PUBLIC_HOST:5432/knowledge_base?sslmode=require"

# Redis
REDIS_URL="redis://redis:6379/0"

# Control API
API_TOKEN="__GENERATE_openssl_rand_hex_32__"

# VPS Public Address (IP or DNS A record — must be set before first startup)
VPS_PUBLIC_HOST="VPS_IP_OR_DNS"

# Wiki Git repository path
WIKI_REPO_PATH="/var/data/wiki"

# Server filesystem root the "Add source → Server files" picker browses and
# ingests from. Must be bind-mounted into the control-api container.
INGEST_ROOT="/var/data/ingest"

# Whether to ensure DB tables on startup (set true once during initial deployment)
ENSURE_TABLES=false


# ============================================================================
# GPU Worker (Colab / Deepnote)
# ============================================================================

# Microsoft Graph OAuth2 (loaded from platform secret stores — never in .env!)
#   Google Colab:  google.colab.userdata.get('AZURE_CLIENT_SECRET')
#   Deepnote:      os.environ['AZURE_CLIENT_SECRET']
AZURE_TENANT_ID="__TENANT_ID__"
AZURE_CLIENT_ID="__CLIENT_ID__"
AZURE_CLIENT_SECRET="__FROM_COLAB_SECRETS__"  # NEVER commit real values

# OneDrive configuration
ONEDRIVE_DRIVE_ID="__DRIVE_ID__"
ONEDRIVE_ROOT_FOLDER="/Enterprise_Knowledge_Base"

# Local LLM backend
LOCAL_LLM_API_BASE="http://127.0.0.1:8000/v1"
# Free model via LiteLLM — supported models include:
#   Qwen2.5-7B-Instruct (via Ollama or vLLM)
#   Qwen2.5-14B-Instruct-AWQ
#   Qwen2.5-32B-Instruct-GPTQ or Llama-3.1-8B/70B-AWQ (larger VRAM)
LOCAL_LLM_MODEL="Qwen/Qwen2.5-14B-Instruct-AWQ"

# Embedding model — BGE-M3 runs on GPU worker, cached in Postgres by SHA-256 hash
EMBEDDING_MODEL_NAME="BAAI/bge-m3"


# ============================================================================
# LiteLLM / Local LLM Configuration
# ============================================================================

# LiteLLM proxy / gateway URL (optional — if using a remote LiteLLM proxy)
# LITELLM_PROXY_URL="http://localhost:4000"

# Default model for LiteLLM completion calls (overrides LOCAL_LLM_MODEL if set)
# LITELLM_DEFAULT_MODEL="Qwen/Qwen2.5-14B-Instruct-AWQ"

# Model list supported by LiteLLM for local vLLM / Ollama backends:
#   Qwen/Qwen2.5-7B-Instruct-Q4_K_M      (via Ollama, ~3GB VRAM)
#   Qwen/Qwen2.5-14B-Instruct-AWQ        (via vLLM/LiteLLM, ~8-9GB VRAM)
#   Qwen/Qwen2.5-32B-Instruct-GPTQ       (via vLLM/LiteLLM, ~16-25GB VRAM)
#   Llama-3.1-8B-Instruct-AWQ            (via vLLM/LiteLLM, ~6GB VRAM)
#   Llama-3.1-70B-Instruct-AWQ           (via vLLM/LiteLLM, ~40-50GB VRAM)
#   All of the above are free / open-weights models — no paid API keys required.

# If using a local vLLM server:
#   vLLM server URL: http://127.0.0.1:8000/v1
#   Supported: any OpenAI-compatible model loaded into vLLM

# If using Ollama:
#   Model name format: "qwen2.5:7b-instruct-q4_k_m" or similar
#   Ollama automatically serves via its own API endpoint

# LITE ENABLEMENT: To use free open-weights models with LiteLLM:
#   1. Start vLLM server:  vllm serve Qwen/Qwen2.5-14B-Instruct-AWQ
#   2. Or start Ollama:     ollama serve / ollama pull qwen2.5:14b-instruct-q4_k_m
#   3. Set LOCAL_LLM_MODEL to the chosen model
#   4. LiteLLM will route to the local endpoint automatically
#   5. No paid LLM or embedding APIs are used — everything is self-hosted